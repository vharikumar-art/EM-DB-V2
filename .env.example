# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=EmailDataBase

# JWT
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_ENCRYPTION_KEY=change-this-to-a-random-encryption-key

# App
APP_NAME=Email Marketing Management System
ENV=development
# Set ENV=production (or another non-development value) for deployed environments.
# Comma-separated frontend origins; add deployed frontend origins in deployment config.
CORS_ORIGINS=http://localhost:5173
EMAIL_MASTER_DROPDOWN_CACHE_KEY=email_master:dropdown_options
EMAIL_MASTER_DROPDOWN_CACHE_TTL_SECONDS=1800
PROFILE_PICTURE_STORAGE_DIR=./uploads/profile-pictures-test
# Set to ./uploads/profile-pictures-production in production.

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/start-campaign
N8N_API_KEY=change-this-n8n-shared-secret

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# LangChain / OpenAI
OPENAI_API_KEY=sk-...
LANGCHAIN_MODEL=gpt-4o-mini
LANGCHAIN_ENABLED=true

# Gmail SMTP
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
